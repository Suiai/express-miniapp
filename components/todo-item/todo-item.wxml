<!-- components/todo-item/todo-item.wxml -->
<view class="todo-item {{todo.completed ? 'completed' : ''}}" bindtap="onTap">

  <!-- 左滑操作区 -->
  <view class="todo-content">

    <!-- 完成勾选按钮 -->
    <view class="check-btn {{todo.completed ? 'checked' : ''}}" catchtap="onToggle">
      <view class="check-icon" wx:if="{{todo.completed}}">✓</view>
    </view>

    <!-- 内容区 -->
    <view class="todo-info">
      <view class="todo-header">
        <text class="todo-title">{{todo.title}}</text>
        <view class="todo-tags">
          <text class="priority-tag {{priorityClass}}" wx:if="{{todo.priority}}">{{priorityText}}</text>
          <text class="due-tag overdue" wx:if="{{overdue}}">已过期</text>
          <text class="due-tag" wx:elif="{{todo.dueDate}}">{{todo.dueDate}}</text>
        </view>
      </view>
      <text class="todo-desc" wx:if="{{todo.desc}}">{{todo.desc}}</text>
      <view class="todo-footer">
        <text class="todo-time">{{timeText}}</text>
      </view>
    </view>

  </view>

  <!-- 右侧操作按钮 -->
  <view class="todo-actions">
    <view class="action-btn edit-btn" catchtap="onEdit">
      <text>编辑</text>
    </view>
    <view class="action-btn delete-btn" catchtap="onDelete">
      <text>删除</text>
    </view>
  </view>

</view>
