/* components/todo-item/todo-item.wxss */

.todo-item {
  position: relative;
  display: flex;
  align-items: stretch;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.todo-item:active {
  transform: scale(0.99);
}

.todo-content {
  flex: 1;
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  min-width: 0;
}

/* 完成勾选按钮 */
.check-btn {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid #DCDFE6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  margin-top: 4rpx;
  transition: all 0.2s ease;
}

.check-btn.checked {
  background: #52C41A;
  border-color: #52C41A;
}

.check-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
}

/* 内容区 */
.todo-info {
  flex: 1;
  min-width: 0;
}

.todo-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.todo-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #303133;
  word-break: break-all;
  line-height: 1.4;
}

.todo-item.completed .todo-title {
  text-decoration: line-through;
  color: #C0C4CC;
}

.todo-tags {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.priority-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.priority-high {
  background: rgba(255, 77, 79, 0.1);
  color: #FF4D4F;
}

.priority-medium {
  background: rgba(250, 173, 20, 0.1);
  color: #FAAD14;
}

.priority-low {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.due-tag {
  font-size: 20rpx;
  color: #909399;
  white-space: nowrap;
}

.due-tag.overdue {
  color: #FF4D4F;
  font-weight: 500;
}

.todo-desc {
  display: block;
  font-size: 26rpx;
  color: #909399;
  margin-top: 8rpx;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.todo-item.completed .todo-desc {
  text-decoration: line-through;
  color: #DCDFE6;
}

.todo-footer {
  margin-top: 12rpx;
}

.todo-time {
  font-size: 22rpx;
  color: #C0C4CC;
}

/* 右侧操作按钮 */
.todo-actions {
  display: flex;
  align-items: stretch;
  flex-shrink: 0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  font-size: 24rpx;
  color: #FFFFFF;
}

.edit-btn {
  background: #4A90D9;
}

.delete-btn {
  background: #FF4D4F;
}
