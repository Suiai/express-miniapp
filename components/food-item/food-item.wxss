/* components/food-item/food-item.wxss */

.food-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--color-bg-card);
}

/* 菜品图片 */
.food-item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f5f5f5;
}

.food-photo {
  width: 100%;
  height: 100%;
}

.food-photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff5f0, #ffe8d6);
}

.placeholder-icon {
  font-size: 56rpx;
}

/* 菜品信息 */
.food-item-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.food-item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.food-item-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}

.food-item-price {
  margin-top: 10rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 32rpx;
}

/* 右侧箭头 */
.food-item-arrow {
  flex-shrink: 0;
  padding-left: 12rpx;
}

.arrow-icon {
  font-size: 40rpx;
  color: var(--color-text-placeholder);
  font-weight: 300;
}
