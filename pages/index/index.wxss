/* pages/index/index.wxss */

.page-header {
  padding: 20rpx 8rpx 20rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

/* 顶部切换 tabs */
.scope-tabs {
  display: flex;
  background: #f0f0f0;
  border-radius: 12rpx;
  padding: 6rpx;
}

.scope-tab {
  padding: 10rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-regular);
  border-radius: 10rpx;
  transition: all 0.2s ease;
}

.scope-tab.active {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.35);
}

.manage-btn {
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 10rpx;
}

.manage-btn:active {
  background: rgba(255, 107, 53, 0.1);
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 团队选择器 */
.team-scroller {
  white-space: nowrap;
  margin: 0 -24rpx 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.team-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-regular);
  transition: all 0.2s ease;
}

.team-chip.active {
  background: rgba(255, 107, 53, 0.08);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 600;
}

.team-chip-count {
  font-size: 22rpx;
  margin-left: 6rpx;
  opacity: 0.7;
}

.team-empty-hint {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.food-card-wrapper {
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  background: var(--color-bg-card);
  transition: transform 0.15s ease;
}

.food-card-wrapper:active {
  transform: scale(0.98);
}

/* 悬浮添加按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
  z-index: 100;
  transition: all 0.2s ease;
}

.fab-button:active {
  transform: scale(0.9);
  background: var(--color-primary-dark);
}

.fab-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}
