/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 统计卡片 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA5E1 100%);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.3);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.stat-num.active {
  color: #FFE58F;
}

.stat-num.completed {
  color: #B7EB8F;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.filter-tab {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #606266;
  transition: all 0.2s ease;
}

.filter-tab.active {
  background: #4A90D9;
  color: #FFFFFF;
}

.filter-spacer {
  flex: 1;
}

.clear-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #FF4D4F;
}

.clear-btn:active {
  opacity: 0.7;
}

/* 待办列表 */
.todo-list {
  min-height: 200rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #EBEEF5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-inner {
  font-size: 80rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #606266;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #909399;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  z-index: 100;
  transition: all 0.2s ease;
}

.fab-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.4);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}
