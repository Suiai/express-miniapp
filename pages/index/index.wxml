<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部标题区域 -->
  <view class="page-header">
    <text class="page-title">今日菜单</text>
    <text class="page-subtitle">共 {{foodList.length}} 道菜品</text>
  </view>

  <!-- 菜品列表 -->
  <block wx:if="{{foodList.length > 0}}">
    <view
      class="food-card-wrapper"
      wx:for="{{foodList}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onTapFood"
    >
      <food-item
        name="{{item.name}}"
        description="{{item.description}}"
        image="{{item.image}}"
        price="{{item.price}}"
      />
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:elif="{{!loading}}" class="empty-state">
    <image class="empty-icon" src="/assets/empty-food.png" mode="aspectFit" />
    <text class="empty-text">还没有菜品，点击下方 + 添加</text>
  </view>

  <!-- 悬浮添加按钮 -->
  <view class="fab-button" bindtap="onTapAdd">
    <text class="fab-icon">+</text>
  </view>
</view>
