/* pages/edit/edit.wxss */

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 表单卡片 */
.form-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  position: relative;
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #303133;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #FF4D4F;
  margin-right: 6rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #303133;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #303133;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-placeholder {
  color: #C0C4CC;
}

.char-count {
  position: absolute;
  right: 8rpx;
  bottom: -32rpx;
  font-size: 22rpx;
  color: #C0C4CC;
}

/* 优先级选择器 */
.priority-selector {
  display: flex;
  gap: 20rpx;
}

.priority-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #606266;
  border: 4rpx solid transparent;
  transition: all 0.2s ease;
}

.priority-option.selected {
  background: rgba(74, 144, 217, 0.08);
  border-color: #4A90D9;
  color: #4A90D9;
  font-weight: 500;
}

.priority-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.priority-dot.high {
  background: #FF4D4F;
}

.priority-dot.medium {
  background: #FAAD14;
}

.priority-dot.low {
  background: #52C41A;
}

/* 日期选择 */
.date-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.date-display {
  flex: 1;
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.date-text {
  font-size: 28rpx;
  color: #303133;
}

.date-text.placeholder {
  color: #C0C4CC;
}

.date-clear {
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  color: #FF4D4F;
}

.date-clear:active {
  opacity: 0.7;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.action-btn.cancel {
  background: #F5F7FA;
  color: #606266;
}

.action-btn.cancel:active {
  background: #EBEEF5;
}

.action-btn.save {
  background: #4A90D9;
  color: #FFFFFF;
}

.action-btn.save:active {
  background: #3A7BC8;
}
