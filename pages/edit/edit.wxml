<!-- pages/edit/edit.wxml -->
<view class="page">

  <!-- 表单卡片 -->
  <view class="form-card">

    <!-- 标题 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text>标题</text>
      </view>
      <input
        class="form-input"
        placeholder="请输入待办标题"
        placeholder-class="input-placeholder"
        value="{{title}}"
        bindinput="onTitleInput"
        maxlength="50"
        confirm-type="done"
      />
      <text class="char-count">{{title.length}}/50</text>
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <view class="form-label">
        <text>描述</text>
      </view>
      <textarea
        class="form-textarea"
        placeholder="添加详细描述（可选）"
        placeholder-class="input-placeholder"
        value="{{desc}}"
        bindinput="onDescInput"
        maxlength="200"
        auto-height
      />
      <text class="char-count">{{desc.length}}/200</text>
    </view>

  </view>

  <!-- 优先级选择 -->
  <view class="form-card">
    <view class="form-label">
      <text>优先级</text>
    </view>
    <view class="priority-selector">
      <view
        class="priority-option {{priority === 'high' ? 'selected' : ''}}"
        bindtap="onPriorityChange"
        data-priority="high"
      >
        <view class="priority-dot high"></view>
        <text>高</text>
      </view>
      <view
        class="priority-option {{priority === 'medium' ? 'selected' : ''}}"
        bindtap="onPriorityChange"
        data-priority="medium"
      >
        <view class="priority-dot medium"></view>
        <text>中</text>
      </view>
      <view
        class="priority-option {{priority === 'low' ? 'selected' : ''}}"
        bindtap="onPriorityChange"
        data-priority="low"
      >
        <view class="priority-dot low"></view>
        <text>低</text>
      </view>
    </view>
  </view>

  <!-- 截止日期 -->
  <view class="form-card">
    <view class="form-label">
      <text>截止日期</text>
    </view>
    <view class="date-row">
      <picker mode="date" value="{{dueDate}}" bindchange="onDateChange">
        <view class="date-display">
          <text class="date-text {{dueDate ? '' : 'placeholder'}}">{{dueDate || '选择日期（可选）'}}</text>
        </view>
      </picker>
      <view class="date-clear" wx:if="{{dueDate}}" bindtap="onClearDate">
        <text>清除</text>
      </view>
    </view>
  </view>

</view>

<!-- 底部操作栏 -->
<view class="action-bar">
  <view class="action-btn cancel" bindtap="onCancel">
    <text>取消</text>
  </view>
  <view class="action-btn save" bindtap="onSave">
    <text>{{isEdit ? '保存修改' : '添加待办'}}</text>
  </view>
</view>
