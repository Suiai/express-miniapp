/* pages/add/add.wxss */

/* 归属标识 */
.scope-badge {
  display: inline-flex;
  background: rgba(255, 107, 53, 0.1);
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
  margin-bottom: 20rpx;
}

.scope-badge-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 照片上传区域 */
.upload-area {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: var(--color-bg-card);
  border: 2rpx dashed var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  margin-bottom: 24rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon {
  font-size: 64rpx;
}

.upload-text {
  font-size: 30rpx;
  color: var(--color-text-regular);
  font-weight: 500;
}

.upload-hint {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.upload-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  padding: 16rpx 0;
  display: flex;
  justify-content: center;
}

.upload-mask-text {
  color: #ffffff;
  font-size: 26rpx;
}

/* 表单区域 */
.form-section {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 40rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.form-input {
  font-size: 30rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}

.form-textarea {
  font-size: 30rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
  min-height: 80rpx;
  width: 100%;
  box-sizing: border-box;
}

.placeholder {
  color: var(--color-text-placeholder);
}

/* 保存按钮 */
.save-btn {
  margin-top: 20rpx;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}
