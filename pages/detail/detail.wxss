/* pages/detail/detail.wxss */

/* 菜品大图 */
.food-image-section {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #f0f0f0;
}

.food-image {
  width: 100%;
  height: 100%;
}

.food-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff5f0, #ffe8d6);
}

.placeholder-icon {
  font-size: 120rpx;
}

/* 信息卡片 */
.info-card {
  padding: 32rpx 24rpx;
}

.food-name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.food-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.food-desc {
  font-size: 28rpx;
  color: var(--color-text-regular);
  line-height: 1.8;
}

/* 操作区 */
.action-section {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.order-btn {
  height: 96rpx;
  font-size: 34rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.action-hint {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

/* 管理操作 */
.manage-row {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.btn-manage {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--color-bg-card);
  color: var(--color-text-regular);
  border: 1rpx solid var(--color-border);
}

.btn-manage::after {
  border: none;
}

.manage-icon {
  font-size: 30rpx;
}

.btn-delete {
  color: #e64340;
}
