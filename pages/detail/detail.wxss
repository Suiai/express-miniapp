/* pages/detail/detail.wxss */

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 状态卡片 */
.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA5E1 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.3);
}

.status-card.completed {
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.3);
}

.status-icon {
  margin-bottom: 16rpx;
}

.check-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.check-circle.checked {
  background: rgba(255, 255, 255, 0.9);
  border-color: rgba(255, 255, 255, 0.9);
}

.check-mark {
  font-size: 44rpx;
  color: #52C41A;
  font-weight: bold;
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.status-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 信息卡片 */
.info-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.info-label {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.info-content {
  font-size: 30rpx;
  color: #303133;
  line-height: 1.6;
  word-break: break-all;
}

.title-content {
  font-size: 34rpx;
  font-weight: 600;
}

.desc-content {
  font-size: 28rpx;
  color: #606266;
}

.completed-text {
  text-decoration: line-through;
  color: #C0C4CC;
}

/* 属性行 */
.attr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.attr-label {
  font-size: 28rpx;
  color: #909399;
}

.attr-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #303133;
}

.attr-divider {
  height: 1rpx;
  background: #EBEEF5;
}

.priority-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.priority-high {
  background: rgba(255, 77, 79, 0.1);
  color: #FF4D4F;
}

.priority-medium {
  background: rgba(250, 173, 20, 0.1);
  color: #FAAD14;
}

.priority-low {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.overdue-text {
  color: #FF4D4F;
  font-weight: 500;
}

.overdue-badge {
  background: #FF4D4F;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.placeholder-text {
  color: #C0C4CC;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.action-btn.delete {
  background: rgba(255, 77, 79, 0.08);
  color: #FF4D4F;
}

.action-btn.delete:active {
  background: rgba(255, 77, 79, 0.15);
}

.action-btn.edit {
  background: #4A90D9;
  color: #FFFFFF;
}

.action-btn.edit:active {
  background: #3A7BC8;
}
