<!-- pages/detail/detail.wxml -->
<view class="container" wx:if="{{food}}">
  <!-- 菜品大图 -->
  <view class="food-image-section">
    <image
      wx:if="{{food.image}}"
      class="food-image"
      src="{{food.image}}"
      mode="aspectFill"
    />
    <view wx:else class="food-image-placeholder">
      <text class="placeholder-icon">🍽️</text>
    </view>
  </view>

  <!-- 菜品信息卡片 -->
  <view class="card info-card">
    <view class="food-name-row">
      <text class="food-name">{{food.name}}</text>
      <text wx:if="{{food.price}}" class="price-tag">{{food.price}}</text>
    </view>
    <view class="scope-tag-row">
      <text class="scope-tag {{food.scope === 'team' ? 'tag-team' : 'tag-personal'}}">
        {{food.scope === 'team' ? '团队菜谱' : '个人菜谱'}}
      </text>
      <text wx:if="{{food.scope === 'team'}}" class="scope-team-name">{{food.teamName}}</text>
    </view>
    <view class="food-desc">{{food.description}}</view>
  </view>

  <!-- 操作区 -->
  <view class="action-section">
    <button
      class="btn btn-primary btn-block order-btn"
      bindtap="onConfirmOrder"
      loading="{{ordering}}"
      disabled="{{ordering}}"
    >
      {{ordering ? '处理中...' : '确认点餐'}}
    </button>
    <text class="action-hint">点击确认后将收到微信通知</text>

    <!-- 管理操作 -->
    <view class="manage-row">
      <button class="btn-manage btn-edit" bindtap="onEdit">
        <text class="manage-icon">✏️</text>
        <text>编辑</text>
      </button>
      <button class="btn-manage btn-delete" bindtap="onDelete">
        <text class="manage-icon">🗑️</text>
        <text>删除</text>
      </button>
    </view>
  </view>
</view>
